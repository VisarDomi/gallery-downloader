{
    "name": "gallery-downloader-monorepo",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "gallery-sources",
        "gallery-server/downloader"
    ],
    "scripts": {
        "build": "npm run build:shared && npm run build:downloader",
        "build:shared": "npm run build -w gallery-sources",
        "build:downloader": "npm run build -w downloader",
        "test": "npm run test -w downloader",
        "start": "npm run build && systemctl --user start gallery-downloader.service",
        "restart": "npm run build && systemctl --user restart gallery-downloader.service",
        "stop": "systemctl --user stop gallery-downloader.service",
        "logs": "journalctl --user -u gallery-downloader.service -f",
        "status": "systemctl --user status gallery-downloader.service --no-pager",
        "status:all": "systemctl --user status gallery-downloader.service gallery-xvfb.service komga.service --no-pager",
        "status:komga": "systemctl --user status komga.service --no-pager",
        "logs:komga": "journalctl --user -u komga.service -f",
        "export:komga": "node gallery-server/scripts/export-komga-cbz.mjs",
        "scan:komga": "node gallery-server/scripts/scan-komga.mjs",
        "sync:favorites": "node gallery-server/scripts/favorites-command.mjs sync",
        "reconcile:favorites": "node gallery-server/scripts/favorites-command.mjs reconcile",
        "download:imhentai": "npm run download:imhentai -w downloader --"
    }
}
