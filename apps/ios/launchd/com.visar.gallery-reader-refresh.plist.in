<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.visar.gallery-reader-refresh</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/caffeinate</string><string>-i</string>
    <string>/usr/bin/python3</string><string>@ROOT@/apps/ios/scripts/refresh.py</string>
    <string>refresh</string><string>--scheduled</string>
    <string>--config</string><string>@CONFIG@</string>
  </array>
  <key>WorkingDirectory</key><string>@ROOT@</string>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>600</integer>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>StandardOutPath</key><string>@ROOT@/build/refresh/last-check.log</string>
  <key>StandardErrorPath</key><string>@ROOT@/build/refresh/last-check.log</string>
</dict></plist>
